{
    "debuglog": {
        "prefix": "dbg",
        "description": "",
        "body": [
            "# TODO: REMOVE JAMIL",
            "print('-- DEBUG JAMIL --')",
            "print($0)",
            "print('-- DEBUG JAMIL --')",
            "# TODO: REMOVE JAMIL"
        ]
    },
    "debuglogpretty": {
        "prefix": "dbgp",
        "description": "",
        "body": [
            "# TODO: REMOVE JAMIL",
            "print('-- DEBUG JAMIL --')",
            "from pprint import pprint",
            "",
            "pprint($0)",
            "print('-- DEBUG JAMIL --')",
            "# TODO: REMOVE JAMIL"
        ]
    },
    "class": {
        "prefix": "class",
        "description": "",
        "body": [
            "class ${TM_FILENAME_BASE/(^[a-z])|((?<=[_])[a-z])|[_]/${1:/upcase}${2:/upcase}/g}:",
            "    ${0:pass}"
        ]
    },
    "iserr": {
        "prefix": "iserr",
        "description": "",
        "body": ["if isinstance($1, Err):", "  ${0:pass}"]
    },
    "isok": {
        "prefix": "isok",
        "description": "",
        "body": ["if isinstance($1, Ok):", "  ${0:pass}"]
    },
    "ain": {
        "prefix": "ai",
        "description": "",
        "body": ["assert isinstance($1,$2)"]
    },
    "anin": {
        "prefix": "ani",
        "description": "",
        "body": ["assert not isinstance($1,$2)"]
    },
    "match": {
        "prefix": "match",
        "description": "",
        "body": ["match $1:", "  case $0:", "    pass"]
    },
    "matchr": {
        "prefix": "matchr",
        "description": "",
        "body": [
            "match $1:",
            "  case Err(err):",
            "    return Err(err)",
            "  case Ok($0):",
            "    pass"
        ]
    },
    "isin": {
        "prefix": "isin",
        "description": "",
        "body": ["if isinstance($1,$2):", "  ${0:pass}"]
    },
    "nisin": {
        "prefix": "nisin",
        "description": "",
        "body": ["if not isinstance($1,$2):", "  ${0:pass}"]
    }
}
